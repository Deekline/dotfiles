return {
	"dense-analysis/ale",
	lazy = false,
	config = function()
		local g = vim.g

		g.ale_ruby_rubocop_auto_correct_all = 1
		g.ale_set_highlights = 0
		g.ale_disable = 0

		g.ale_linters = {
			lua = { "lua_language_server" },
			vue = { "volar", "eslint" },
		}

		g.ale_fixers = {
			vue = { "eslint" },
			javascript = { "eslint" },
			typescript = { "eslint" },
			lua = { "stylua" },
			react = { "eslint" },
		}

		g.ale_fix_on_save = 1
		vim.cmd([[
      autocmd BufEnter *.vue let b:ale_linters = ['eslint', 'volar']
      autocmd BufEnter *.lua let b:ale_linters = ['lua_language_server']
    ]])
		vim.cmd("ALEEnable")
	end,
}
